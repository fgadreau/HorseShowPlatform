# Frontend-safe local values. Never copy production values into this file.
VITE_DEPLOY_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
VITE_SUPABASE_PROJECT_REF=local
VITE_PRODUCTION_SUPABASE_PROJECT_REF=srzzituovoxkvvlaesxa
# Legacy Supabase projects may still use an anon key instead.
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Server-only secrets. Keep these in Supabase/Vercel secret storage.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5173
RESEND_API_KEY=
NRHA_API_KEY=
