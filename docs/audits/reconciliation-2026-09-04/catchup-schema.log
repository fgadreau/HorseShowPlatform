    AS $$
begin
  if not public.can_access_horse(p_horse_id) then
    raise exception 'Not authorized to read this horse identity lock'
      using errcode = 'insufficient_privilege';
  end if;

  return query
  select * from public.horse_identity_locks_for(p_horse_id);
end;
$$;


