    credential_type text,
    requirement_group_code text,
    match_rule text DEFAULT 'all'::text NOT NULL,
    validity_rule text DEFAULT 'active_on_reference_date'::text NOT NULL,
    enforcement_mode text DEFAULT 'blocking'::text NOT NULL,
    is_required boolean DEFAULT true NOT NULL,
    is_active boolean DEFAULT true NOT NULL,
    label text,
    settings jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_by_user_id uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    incentive_program_id uuid,
    CONSTRAINT eligibility_requirements_check CHECK (((requirement_group_code IS NOT NULL) OR (match_rule = 'all'::text))),
    CONSTRAINT eligibility_requirements_credential_type_check CHECK (((credential_type IS NULL) OR (credential_type = ANY (ARRAY['membership'::text, 'license'::text, 'registration'::text, 'certification'::text, 'insurance'::text, 'other'::text])))),
    CONSTRAINT eligibility_requirements_enforcement_mode_check CHECK ((enforcement_mode = ANY (ARRAY['warning'::text, 'blocking'::text]))),
    CONSTRAINT eligibility_requirements_match_rule_check CHECK ((match_rule = ANY (ARRAY['all'::text, 'at_least_one'::text]))),
    CONSTRAINT eligibility_requirements_program_context_check CHECK ((((requirement_type = 'program_nomination'::text) AND (subject_type = 'horse'::text) AND (incentive_program_id IS NOT NULL)) OR ((requirement_type <> 'program_nomination'::text) AND (incentive_program_id IS NULL)))),
    CONSTRAINT eligibility_requirements_requirement_type_check CHECK ((requirement_type = ANY (ARRAY['host_membership'::text, 'external_contact_credential'::text, 'horse_registration'::text, 'rider_insurance'::text, 'program_nomination'::text]))),
    CONSTRAINT eligibility_requirements_scope_target_check CHECK ((((scope_type = 'organization_discipline'::text) AND (organization_discipline_id IS NOT NULL) AND (block_id IS NULL) AND (class_id IS NULL) AND (block_template_id IS NULL) AND (class_template_id IS NULL)) OR ((scope_type = 'block'::text) AND (organization_discipline_id IS NULL) AND (block_id IS NOT NULL) AND (class_id IS NULL) AND (block_template_id IS NULL) AND (class_template_id IS NULL)) OR ((scope_type = 'class'::text) AND (organization_discipline_id IS NULL) AND (block_id IS NULL) AND (class_id IS NOT NULL) AND (block_template_id IS NULL) AND (class_template_id IS NULL)) OR ((scope_type = 'block_template'::text) AND (organization_discipline_id IS NULL) AND (block_id IS NULL) AND (class_id IS NULL) AND (block_template_id IS NOT NULL) AND (class_template_id IS NULL)) OR ((scope_type = 'class_template'::text) AND (organization_discipline_id IS NULL) AND (block_id IS NULL) AND (class_id IS NULL) AND (block_template_id IS NULL) AND (class_template_id IS NOT NULL)))),
    CONSTRAINT eligibility_requirements_scope_type_check CHECK ((scope_type = ANY (ARRAY['organization_discipline'::text, 'block'::text, 'class'::text, 'block_template'::text, 'class_template'::text]))),
    CONSTRAINT eligibility_requirements_settings_check CHECK ((jsonb_typeof(settings) = 'object'::text)),
    CONSTRAINT eligibility_requirements_subject_type_check CHECK ((subject_type = ANY (ARRAY['rider'::text, 'owner'::text, 'horse'::text]))),
    CONSTRAINT eligibility_requirements_validity_rule_check CHECK ((validity_rule = ANY (ARRAY['present'::text, 'active_on_reference_date'::text])))
);


