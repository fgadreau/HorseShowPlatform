    CONSTRAINT class_template_divisions_default_payout_percent_check CHECK ((((default_retainage_percent IS NULL) OR ((default_retainage_percent >= (0)::numeric) AND (default_retainage_percent <= (100)::numeric))) AND ((default_sanctioning_fee_percent IS NULL) OR ((default_sanctioning_fee_percent >= (0)::numeric) AND (default_sanctioning_fee_percent <= (100)::numeric))))),
