--
-- Name: set_show_score_live_data_source(uuid, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.set_show_score_live_data_source(target_class_id uuid, target_source text) RETURNS void
    LANGUAGE plpgsql
    SET search_path TO 'public'
    AS $$
begin
  if target_source not in ('scribe', 'announcer') then
    raise exception 'Invalid ShowScore live data source'
      using errcode = 'invalid_parameter_value';
  end if;

  insert into public.show_score_block_setups (
    block_id,
    live_data_source,
    live_source_changed_at,
    live_source_changed_by
  )
  values (
    target_class_id,
    target_source,
    now(),
    auth.email()
  )
  on conflict (block_id) do update
  set live_data_source = excluded.live_data_source,
      live_source_changed_at = excluded.live_source_changed_at,
      live_source_changed_by = excluded.live_source_changed_by,
      updated_at = now();
end;
$$;


ALTER FUNCTION public.set_show_score_live_data_source(target_class_id uuid, target_source text) OWNER TO postgres;

