    organization_id uuid NOT NULL,
    show_id uuid NOT NULL,
    status text DEFAULT 'hidden'::text NOT NULL,
    published_at timestamp with time zone,
    published_by_user_id uuid,
    public_url text,
    visible_fields jsonb DEFAULT '["draw", "backNumber", "rider", "horse", "owner", "divisionNames", "scoreTotal", "status"]'::jsonb NOT NULL,
    legacy_showscore_class_id text,
    legacy_payload jsonb,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    planned_live_status text DEFAULT 'live_scoring'::text NOT NULL,
    published_by text,
    CONSTRAINT show_score_publication_states_status_check CHECK ((status = ANY (ARRAY['hidden'::text, 'live'::text, 'live_no_score'::text, 'live_scoring'::text, 'live_finished'::text, 'pending_review'::text, 'official'::text, 'published'::text])))
);


