-- Name: stall_options; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.stall_options (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    organization_id uuid NOT NULL,
    show_id uuid NOT NULL,
    name character varying(255) NOT NULL,
    description text,
    price numeric(10,2) NOT NULL,
    total_quantity smallint NOT NULL,
    available_quantity smallint NOT NULL,
    duration_days smallint,
    show_day_start_id uuid,
    show_day_end_id uuid,
    category character varying(50),
    notes text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    requires_horse_assignment boolean DEFAULT true NOT NULL,
    limit_per_horse_stalls smallint,
    product_id uuid,
    CONSTRAINT stall_options_available_quantity_check CHECK ((available_quantity >= 0)),
    CONSTRAINT stall_options_category_check CHECK (((category)::text = ANY ((ARRAY['stall'::character varying, 'camping'::character varying, 'parking'::character varying, 'extra'::character varying])::text[]))),
    CONSTRAINT stall_options_check CHECK ((available_quantity <= total_quantity)),
    CONSTRAINT stall_options_limit_per_horse_stalls_check CHECK (((limit_per_horse_stalls IS NULL) OR (limit_per_horse_stalls > 0))),
    CONSTRAINT stall_options_total_quantity_check CHECK ((total_quantity >= 0))
);


ALTER TABLE public.stall_options OWNER TO postgres;

--
-- Name: team_eligibility_decisions; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.team_eligibility_decisions (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    organization_id uuid NOT NULL,
    show_id uuid NOT NULL,
    class_id uuid NOT NULL,
    governing_body_id uuid NOT NULL,
    horse_id uuid NOT NULL,
    rider_contact_id uuid NOT NULL,
    reference_date date NOT NULL,
    status text NOT NULL,
    can_proceed boolean NOT NULL,
    reasons jsonb DEFAULT '[]'::jsonb NOT NULL,
    input_fingerprint text NOT NULL,
    source_mode text NOT NULL,
    external_snapshot_id uuid,
    checked_at timestamp with time zone DEFAULT now() NOT NULL,
    expires_at timestamp with time zone,
    created_by_user_id uuid DEFAULT public.current_profile_id(),
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT team_eligibility_decisions_check CHECK (((expires_at IS NULL) OR (expires_at > checked_at))),
    CONSTRAINT team_eligibility_decisions_check1 CHECK ((((status = 'eligible'::text) AND can_proceed) OR ((status = 'ineligible'::text) AND (NOT can_proceed)) OR (status = 'unavailable'::text))),
    CONSTRAINT team_eligibility_decisions_input_fingerprint_check CHECK ((btrim(input_fingerprint) <> ''::text)),
    CONSTRAINT team_eligibility_decisions_reasons_check CHECK ((jsonb_typeof(reasons) = 'array'::text)),
    CONSTRAINT team_eligibility_decisions_source_mode_check CHECK ((source_mode = ANY (ARRAY['live_external'::text, 'local'::text, 'manual'::text]))),
    CONSTRAINT team_eligibility_decisions_status_check CHECK ((status = ANY (ARRAY['eligible'::text, 'ineligible'::text, 'unavailable'::text])))
);


ALTER TABLE public.team_eligibility_decisions OWNER TO postgres;

--
-- Name: TABLE team_eligibility_decisions; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.team_eligibility_decisions IS 'Immutable HSP decisions for one horse, rider, class, governing body and reference date. External evidence remains in external_data_snapshots.';


