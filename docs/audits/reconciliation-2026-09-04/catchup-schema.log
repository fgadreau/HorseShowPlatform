    status character varying(50) DEFAULT 'reserved'::character varying NOT NULL,
    show_day_start_id uuid,
    show_day_end_id uuid,
    unit_price numeric(10,2),
    total_price numeric(10,2),
    notes text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    cancelled_at timestamp with time zone,
    cancelled_by_user_id uuid,
    quantity smallint DEFAULT 1 NOT NULL,
    affects_inventory boolean DEFAULT true NOT NULL,
    billable boolean DEFAULT true NOT NULL,
    CONSTRAINT stall_bookings_quantity_check CHECK ((quantity > 0)),
    CONSTRAINT stall_bookings_status_check CHECK (((status)::text = ANY ((ARRAY['requested'::character varying, 'reserved'::character varying, 'active'::character varying, 'cancelled'::character varying, 'completed'::character varying])::text[])))
);


ALTER TABLE public.stall_bookings OWNER TO postgres;

