--
-- Name: days_insert(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.days_insert() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
begin
  insert into public.show_days (id, organization_id, show_id, day_name, day_date, sort_order, created_at, updated_at)
  values (
    coalesce(new.id, gen_random_uuid()),
    new.association_id,
    new.show_id,
    new.label,
    new.date::date,
    coalesce(new.sort_order, 1),
    coalesce(new.created_at, now()),
    coalesce(new.updated_at, now())
  );
  return new;
end;
$$;


