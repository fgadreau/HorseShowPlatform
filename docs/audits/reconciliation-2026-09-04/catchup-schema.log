--
-- Name: horse_documents; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.horse_documents (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    horse_id uuid NOT NULL,
    document_type character varying(50) NOT NULL,
    status character varying(50) DEFAULT 'pending_review'::character varying NOT NULL,
    verification_source character varying(50) DEFAULT 'manual'::character varying NOT NULL,
    source_url text,
    document_url text,
    certificate_number character varying(120),
    issuer_name text,
    test_or_administered_on date,
    expires_on date,
    result character varying(120),
    horse_name text,
    horse_date_of_birth date,
    horse_external_id text,
    warnings text[] DEFAULT '{}'::text[] NOT NULL,
    payload jsonb DEFAULT '{}'::jsonb NOT NULL,
    reviewed_by_user_id uuid,
    reviewed_at timestamp with time zone,
    review_notes text,
    created_by_user_id uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    document_category text DEFAULT 'health'::text NOT NULL,
    external_credential_issuer_id uuid,
    registration_number text,
    breed_name text,
    original_file_name text,
    mime_type text,
    file_size_bytes bigint,
    content_sha256 text,
    metadata jsonb DEFAULT '{}'::jsonb NOT NULL,
    uploaded_by_organization_id uuid,
    CONSTRAINT horse_documents_category_check CHECK ((document_category = ANY (ARRAY['health'::text, 'registration'::text, 'other'::text]))),
    CONSTRAINT horse_documents_category_type_check CHECK ((((document_category = 'health'::text) AND ((document_type)::text = ANY ((ARRAY['coggins_eia'::character varying, 'influenza_vaccine'::character varying, 'rhino_vaccine'::character varying, 'combo_vaccine'::character varying, 'other'::character varying])::text[]))) OR ((document_category = 'registration'::text) AND ((document_type)::text = ANY ((ARRAY['breed_registration'::character varying, 'breed_pedigree'::character varying, 'ownership_certificate'::character varying, 'other'::character varying])::text[]))) OR (document_category = 'other'::text))),
    CONSTRAINT horse_documents_file_size_check CHECK (((file_size_bytes IS NULL) OR (file_size_bytes >= 0))),
    CONSTRAINT horse_documents_registration_context_check CHECK ((((document_type)::text <> 'breed_registration'::text) OR ((document_category = 'registration'::text) AND (external_credential_issuer_id IS NOT NULL) AND (NULLIF(btrim(registration_number), ''::text) IS NOT NULL)))),
    CONSTRAINT horse_documents_sha256_check CHECK (((content_sha256 IS NULL) OR (content_sha256 ~ '^[0-9a-f]{64}$'::text))),
    CONSTRAINT horse_documents_type_check CHECK (((document_type)::text = ANY ((ARRAY['coggins_eia'::character varying, 'influenza_vaccine'::character varying, 'rhino_vaccine'::character varying, 'combo_vaccine'::character varying, 'breed_registration'::character varying, 'breed_pedigree'::character varying, 'ownership_certificate'::character varying, 'other'::character varying])::text[]))),
    CONSTRAINT horse_health_documents_status_check CHECK (((status)::text = ANY ((ARRAY['pending_review'::character varying, 'verified'::character varying, 'approved'::character varying, 'rejected'::character varying, 'expired'::character varying])::text[]))),
    CONSTRAINT horse_health_documents_verification_source_check CHECK (((verification_source)::text = ANY ((ARRAY['manual'::character varying, 'gvl_qr'::character varying, 'gvl_url'::character varying, 'gvl_api'::character varying, 'upload'::character varying])::text[])))
);


