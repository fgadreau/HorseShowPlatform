--
-- Name: shows; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.shows (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    organization_id uuid NOT NULL,
    name character varying(255) NOT NULL,
    slug character varying(100) NOT NULL,
    description text,
    start_date date NOT NULL,
    end_date date NOT NULL,
    location character varying(255),
    city character varying(100),
    state character varying(50),
    zip_code character varying(20),
    country character varying(2),
    coordinates point,
    status character varying(50) DEFAULT 'draft'::character varying NOT NULL,
    timezone character varying(50),
    modules_enabled jsonb,
    default_currency character varying(3),
    tax_rate numeric(6,3),
    is_public boolean DEFAULT false NOT NULL,
    show_schedule_public boolean DEFAULT false NOT NULL,
    show_draw_public boolean DEFAULT false NOT NULL,
    show_results_public boolean DEFAULT false NOT NULL,
    show_standings_public boolean DEFAULT false NOT NULL,
    image_url text,
    created_by_user_id uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    venue character varying(255),
    legacy_showscore_show_id text,
    reservation_payment_policy text DEFAULT 'pay_at_booking'::text NOT NULL,
    entry_payment_policy text DEFAULT 'card_on_file_preauth'::text NOT NULL,
    entry_preauth_timing text DEFAULT 'show_start'::text NOT NULL,
    entry_preauth_time time without time zone DEFAULT '08:00:00'::time without time zone NOT NULL,
    entry_settlement_timing text DEFAULT 'show_end'::text NOT NULL,
    entry_settlement_due_time time without time zone DEFAULT '14:00:00'::time without time zone NOT NULL,
    entry_auto_capture_enabled boolean DEFAULT true NOT NULL,
    entry_preauth_amount_strategy text DEFAULT 'entry_balance'::text NOT NULL,
    entry_preauth_margin_percent numeric(5,2) DEFAULT 0 NOT NULL,
    livestream_url text,
    is_livestream_public boolean DEFAULT false NOT NULL,
    user_id uuid,
    obs_overlay_mode text DEFAULT 'live'::text NOT NULL,
    entry_deadline_mode text DEFAULT 'block'::text NOT NULL,
    entries_close_at timestamp with time zone,
    reservations_close_at timestamp with time zone,
    late_entries_allowed boolean DEFAULT true NOT NULL,
    late_entry_fee_percent numeric(5,2) DEFAULT 50 NOT NULL,
    livestream_urls_by_date jsonb DEFAULT '{}'::jsonb NOT NULL,
    tv_display_paused boolean DEFAULT false NOT NULL,
    tv_display_message_fr text DEFAULT ''::text NOT NULL,
    tv_display_message_en text DEFAULT ''::text NOT NULL,
    tv_display_video_path text DEFAULT ''::text NOT NULL,
    tv_display_video_name text DEFAULT ''::text NOT NULL,
    tv_display_video_size bigint DEFAULT 0 NOT NULL,
    tv_display_video_arena text DEFAULT ''::text NOT NULL,
    CONSTRAINT shows_entry_deadline_mode_check CHECK ((entry_deadline_mode = ANY (ARRAY['show'::text, 'block'::text]))),
    CONSTRAINT shows_entry_payment_policy_check CHECK ((entry_payment_policy = ANY (ARRAY['card_on_file_preauth'::text, 'manual'::text]))),
    CONSTRAINT shows_entry_preauth_amount_strategy_check CHECK ((entry_preauth_amount_strategy = ANY (ARRAY['entry_balance'::text, 'entry_balance_with_margin'::text]))),
    CONSTRAINT shows_entry_preauth_margin_percent_check CHECK ((entry_preauth_margin_percent >= (0)::numeric)),
    CONSTRAINT shows_entry_preauth_timing_check CHECK ((entry_preauth_timing = ANY (ARRAY['show_start'::text, 'manual'::text]))),
    CONSTRAINT shows_entry_settlement_timing_check CHECK ((entry_settlement_timing = ANY (ARRAY['show_end'::text, 'manual'::text]))),
    CONSTRAINT shows_late_entry_fee_percent_check CHECK (((late_entry_fee_percent >= (0)::numeric) AND (late_entry_fee_percent <= (1000)::numeric))),
    CONSTRAINT shows_obs_overlay_mode_check CHECK ((obs_overlay_mode = ANY (ARRAY['live'::text, 'neutral'::text]))),
    CONSTRAINT shows_reservation_payment_policy_check CHECK ((reservation_payment_policy = ANY (ARRAY['pay_at_booking'::text, 'manual'::text]))),
    CONSTRAINT shows_status_check CHECK (((status)::text = ANY ((ARRAY['draft'::character varying, 'open'::character varying, 'closed'::character varying, 'archived'::character varying])::text[]))),
    CONSTRAINT shows_tv_display_video_size_check CHECK (((tv_display_video_size >= 0) AND (tv_display_video_size <= '2147483648'::bigint)))
);


ALTER TABLE public.shows OWNER TO postgres;

