--

CREATE FUNCTION public.identity_search_key(target_value text) RETURNS text
    LANGUAGE sql IMMUTABLE
    SET search_path TO 'public', 'extensions'
    AS $$
  select regexp_replace(
    lower(extensions.unaccent(coalesce(target_value, ''))),
    '[^a-z0-9]+',
    '',
    'g'
  );
$$;


