--
-- Name: block_result_publications org members can manage class_result_publications; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "org members can manage class_result_publications" ON public.block_result_publications USING ((EXISTS ( SELECT 1
   FROM ((public.blocks c
     JOIN public.organization_members om ON ((om.organization_id = c.organization_id)))
     JOIN public.user_profiles up ON ((up.id = om.user_id)))
  WHERE ((c.id = block_result_publications.block_id) AND (up.user_id = auth.uid())))));


