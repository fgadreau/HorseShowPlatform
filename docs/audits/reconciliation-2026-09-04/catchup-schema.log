--

CREATE TABLE public.eligibility_requirements (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    organization_id uuid NOT NULL,
    scope_type text NOT NULL,
    organization_discipline_id uuid,
    block_id uuid,
    class_id uuid,
