shows|ensure_show_slug_trigger|CREATE TRIGGER ensure_show_slug_trigger BEFORE INSERT OR UPDATE ON public.shows FOR EACH ROW EXECUTE FUNCTION ensure_show_slug()|CREATE OR REPLACE FUNCTION public.ensure_show_slug()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
begin
  if new.slug is null or new.slug = '' then
    new.slug := lower(regexp_replace(coalesce(new.name, ''), '[^a-zA-Z0-9]+', '-', 'g'))
                || '-' || substring(new.id::text, 1, 8);
  end if;
  return new;
end;
$function$

shows|shows_ensure_show_days|CREATE TRIGGER shows_ensure_show_days AFTER INSERT OR UPDATE OF start_date, end_date ON public.shows FOR EACH ROW EXECUTE FUNCTION ensure_show_days_from_show_dates()|CREATE OR REPLACE FUNCTION public.ensure_show_days_from_show_dates()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
begin
  insert into public.show_days (
    organization_id,
    show_id,
    day_date,
    day_name,
    day_number,
    sort_order
  )
  select
    new.organization_id,
    new.id,
    generated_day.day_date::date,
    'Day ' || generated_day.ordinality,
    generated_day.ordinality,
    generated_day.ordinality
  from generate_series(new.start_date, new.end_date, interval '1 day') with ordinality as generated_day(day_date, ordinality)
  on conflict (show_id, day_date) do nothing;

  return new;
end;
$function$

