# Copie ce fichier vers .env.e2e.local. Ne jamais utiliser les secrets de PROD.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_SHOWSCORE_URL=http://127.0.0.1:5174
E2E_DEPLOY_ENV=local
E2E_ALLOW_WRITES=true
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_SUPABASE_PROJECT_REF=local
E2E_PRODUCTION_SUPABASE_PROJECT_REF=srzzituovoxkvvlaesxa
VERCEL_AUTOMATION_BYPASS_SECRET=
SHOWSCORE_VERCEL_AUTOMATION_BYPASS_SECRET=

# smoke: 3 cavaliers complets par défaut; mega: 25. Maximum permis: 100.
E2E_MODE=smoke
E2E_DATASET_SIZE=

# Diagnostic seulement: conserve les données jetables après l’exécution.
E2E_KEEP_DATA=false
