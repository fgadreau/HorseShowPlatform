{
  "name": "horseshowplatform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:draw": "tsc -p tsconfig.draw-test.json && cp scripts/draw-test-package.json .tmp/draw-tests/package.json && node .tmp/draw-tests/scripts/draw-test-program.js",
    "test:payout": "tsc -p tsconfig.payout-test.json && cp scripts/draw-test-package.json .tmp/payout-tests/package.json && node .tmp/payout-tests/scripts/payout-test-program.js",
    "test:paid-warmup": "tsc -p tsconfig.paid-warmup-test.json && cp scripts/draw-test-package.json .tmp/paid-warmup-tests/package.json && node .tmp/paid-warmup-tests/scripts/paid-warmup-submission.test.js",
    "test:identity": "tsc -p tsconfig.identity-test.json && cp scripts/draw-test-package.json .tmp/identity-tests/package.json && node .tmp/identity-tests/scripts/identity-comparison-test.js",
    "test:governing": "tsc -p tsconfig.governing-test.json && cp scripts/draw-test-package.json .tmp/governing-tests/package.json && node .tmp/governing-tests/scripts/governing-bodies-test.js",
    "test:eligibility": "tsc -p tsconfig.eligibility-test.json && cp scripts/draw-test-package.json .tmp/eligibility-tests/package.json && node .tmp/eligibility-tests/scripts/eligibility-engine-test.js",
    "test:promotion": "node scripts/verify-production-migrations.mjs origin/main HEAD",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:e2e:local:mega": "E2E_MODE=mega node scripts/run-e2e-local.mjs",
    "test:e2e:smoke": "E2E_MODE=smoke playwright test",
    "test:e2e:mega": "E2E_MODE=mega playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:capacity": "node scripts/run-showscore-capacity.mjs",
    "test:capacity:aggregate": "node scripts/aggregate-showscore-capacity.mjs",
    "test:capacity:config": "node --test scripts/capacity/*.test.mjs",
    "test:broadcast": "node scripts/verify-showscore-public-broadcast.mjs",
    "vet:worker": "node server/vet/local-server.mjs",
    "test:vet": "node --test scripts/vet/*.test.mjs",
    "vet:local": "node scripts/vet/run-local.mjs",
    "test:vet:local": "node scripts/vet/run-local.mjs test",
    "test:vet:browser": "node --test scripts/vet/omvq.browser.mjs",
    "test:vet:pdf": "node scripts/vet/pdf-layout.browser.mjs",
    "test:vet:sql": "node scripts/vet/test-sql-local.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^5.6.205",
    "playwright-core": "1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "supabase": "^2.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "ws": "^8.21.2"
  }
}
